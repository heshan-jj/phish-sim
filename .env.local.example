# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=security@yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI provider: minimax (default) | nasiko
AI_PROVIDER=minimax

# Nasiko (when AI_PROVIDER=nasiko) — Kong gateway on your VPS
NASIKO_BASE_URL=http://127.0.0.1:9100
NASIKO_ACCESS_KEY=
NASIKO_ACCESS_SECRET=
NASIKO_TIMEOUT_MS=60000
# Recommended: direct PhishSim agent URL (bypasses router LLM selection)
# NASIKO_AGENT_ROUTE=http://<your-vps>:9100/agents/agent-phish-sim-content-v2

# MiniMax AI (required for minimax provider; fallback when nasiko fails)
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimaxi.chat/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M2.7
AI_LOG_RAW_RESPONSES=false
AI_LAUNCH_CONCURRENCY=2

# MiniMax TTS (optional, for vishing audio)
MINIMAX_TTS_ENABLED=false
MINIMAX_TTS_API_URL=https://api.minimaxi.chat/v1/t2a_v2
